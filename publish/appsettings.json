{
  "ConnectionStrings": {
    "DefaultConnection": "Server=MOHAMED-ELHADDA;Database=UniNestDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
